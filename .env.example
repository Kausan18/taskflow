# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → Database → Connection string → URI (Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Dashboard → Settings → Database → Connection string → URI (Session mode / Direct)
# Required by Prisma for migrations (pgBouncer doesn't support DDL)
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   cat private.pem | base64 -w 0   → paste below
#   cat public.pem  | base64 -w 0   → paste below
JWT_PRIVATE_KEY=base64_encoded_rsa_private_key_pem
JWT_PUBLIC_KEY=base64_encoded_rsa_public_key_pem
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# ── Redis ─────────────────────────────────────────────────────────────────────
# When running via Docker Compose use the service name:
REDIS_URL=redis://cache:6379
# When running backend locally without Docker:
# REDIS_URL=redis://localhost:6379

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── hCaptcha ──────────────────────────────────────────────────────────────────
# hcaptcha.com → Sites → Secret Key
HCAPTCHA_SECRET=your_hcaptcha_secret_key
# Set to 'false' to skip captcha in dev
HCAPTCHA_ENABLED=false

# ── App ───────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
